runtime: custom
env: flex

resources:
  cpu: 1
  memory_gb: 2
  disk_size_gb: 10

automatic_scaling:
  min_num_instances: 1
  max_num_instances: 2

beta_settings:
  cloud_sql_instances: [PROJECT_ID]:[REGION]:tbot-db

env_variables:
  FLASK_APP: run.py
  FLASK_ENV: production
  LLM_PROVIDER: vertex_ai
  LLM_MAX_TOKENS: "65535"
  SIGNAL_EXPIRY_CANDLES: "3"
  DATABASE_URL: postgresql://postgres:[YOUR_PASSWORD]@/signals_db?host=/cloudsql/[PROJECT_ID]:[REGION]:tbot-db
  TELEGRAM_BOT_TOKEN: "[YOUR_TELEGRAM_BOT_TOKEN]"
  TELEGRAM_CHAT_ID: "[YOUR_TELEGRAM_CHAT_ID]"
  LLM_MODEL: "[YOUR_LLM_MODEL]"
  VERTEX_PROJECT_ID: "[YOUR_VERTEX_PROJECT_ID]"
  VERTEX_LOCATION: "global"
  VERTEX_TEMPERATURE: "0.2"
  # VERTEX_THINKING_LEVEL: "MEDIUM"

  # Groq / OpenAI-compatible (legacy — uncomment and switch LLM_PROVIDER to use)
  # LLM_API_URL: https://api.groq.com/openai/v1/chat/completions
  # LLM_API_KEY: "[YOUR_LLM_API_KEY]"
  # GROQ_API_KEY: "[YOUR_GROQ_API_KEY]"
